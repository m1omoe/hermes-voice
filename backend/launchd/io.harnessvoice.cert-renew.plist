<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
        "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- DEPRECATED: this checked-in asset is intentionally non-operational
         and is not part of the guided setup path. Guided setup uses
         Tailscale Serve, which renews its own certificate transparently and
         never generates a renewal agent. This stub only documents the shape
         of a certificate-renewal LaunchAgent for an advanced manual
         direct-TLS runtime that manages its own certificate; the guided
         provisioner does not produce or install it:
         uv run --project backend --extra provision python
           backend/scripts/provision_macos.py setup -->
    <key>Label</key>
    <string>io.harnessvoice.cert-renew.deprecated</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/false</string>
        <string>This LaunchAgent is not generated by the guided provisioner.</string>
    </array>
    <key>Disabled</key>
    <true/>
</dict>
</plist>
